rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnHousehold(householdId) {
      return isSignedIn()
        && householdId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdIds;
    }

    function isMemberOf(householdId) {
      return isSignedIn() && isOwnHousehold(householdId);
    }

    function isServerWritable() {
      return request.auth == null && request.method == 'set';
    }

    // users/{uid} — owner only. Derived membership arrays are still owner-writable
    // so create/join can update them from the client.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // joinCodes/{code} — single-doc lookup so create/join never need a
    // membership-restricted query against households by joinCode.
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string;
      allow update, delete: if false;
    }

    // households/{householdId} — anyone signed in can fetch a single household
    // by id (needed to resolve a join code); listing/browsing still requires
    // membership. Only the creator can create; details are frozen after.
    match /households/{householdId} {
      allow get: if isSignedIn();
      allow list: if isMemberOf(householdId);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'joinCode', 'createdBy', 'createdAt', 'defaultPointsPerTask'])
        && request.resource.data.size() == 5;
      allow update, delete: if false;

      // members/{uid} — member reads only their own record; only the Cloud
      // Function (Admin SDK, unauth'd server write) may touch totals/streak/level.
      match /members/{uid} {
        allow read: if isMemberOf(householdId);
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['displayName', 'avatarConfig', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['displayName', 'avatarConfig', 'joinedAt']);
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarConfig']);
        allow delete: if false;
      }

      // tasks/{taskId} — members can CRUD household tasks with schema validation.
      match /tasks/{taskId} {
        allow read: if isMemberOf(householdId);
        allow create: if isMemberOf(householdId)
          && request.resource.data.keys().hasAll(['title', 'points', 'recurrence', 'createdBy'])
          && request.resource.data.createdBy == request.auth.uid
          && (request.resource.data.recurrence in ['daily', 'weekly', 'once']);
        allow update: if isMemberOf(householdId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'points', 'recurrence', 'assignedTo', 'icon', 'room', 'active', 'repeatable']);
        allow delete: if isMemberOf(householdId);
      }

      // taskCompletions/{completionId} — clients write raw facts only (create);
      // the Cloud Function marks `processed` and writes scoring (server-write).
      match /taskCompletions/{completionId} {
        allow read: if isMemberOf(householdId);
        allow create: if isMemberOf(householdId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['taskId', 'userId', 'completedAt', 'dateKey', 'pointsAwarded', 'weekKey', 'monthKey'])
          && request.resource.data.pointsAwarded is number
          && request.resource.data.pointsAwarded == get(/databases/$(database)/documents/households/$(householdId)/tasks/$(request.resource.data.taskId)).data.points
          && !('processed' in request.resource.data);
        allow update: if isServerWritable();
        // Members can un-complete their own task by deleting their own completion record.
        allow delete: if isMemberOf(householdId) && resource.data.userId == request.auth.uid;
      }

      // achievements/{achievementId} — static catalog, read-only for members.
      match /achievements/{achievementId} {
        allow read: if isMemberOf(householdId);
        allow write: if false;
      }

      // members/{uid}/unlockedAchievements/{achievementId} — written only by the
      // Cloud Function (Admin SDK). Members may read (their own household).
      match /members/{uid}/unlockedAchievements/{achievementId} {
        allow read: if isMemberOf(householdId);
        allow create: if isServerWritable();
        allow update, delete: if false;
      }
    }
  }
}
